# Job Copilot — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- AI provider ---
# Get a Gemini API key at: https://aistudio.google.com/apikey
# Leave empty to run without AI features (AI endpoints return fallback text).
GEMINI_API_KEY=your-gemini-api-key-here

# --- Database ---
# SQLAlchemy URL. Defaults to a local SQLite file at data/copilot.db when unset.
# DATABASE_URL=sqlite:///./data/copilot.db

# --- Identity ---
# Only "local" is supported today: all requests act as a single bootstrap local user.
# Authentication (login/JWT) is NOT yet implemented — keep the server bound to 127.0.0.1.
AUTH_MODE=local
# Email recorded for the bootstrap local user (no email is ever sent).
LOCAL_USER_EMAIL=local-user@localhost
