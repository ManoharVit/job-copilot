{
  "manifest_version": 3,
  "name": "Job Copilot",
  "version": "1.0.0",
  "description": "Autofills job applications",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Autofill current page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "overlay.css"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}