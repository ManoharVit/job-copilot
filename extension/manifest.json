{
  "manifest_version": 3,
  "name": "Job Copilot",
  "description": "Autofills job applications",
  "version": "1.0.0",
  "icons": {
    "16": "icons/job-copilot.png",
    "32": "icons/job-copilot.png",
    "48": "icons/job-copilot.png",
    "128": "icons/job-copilot.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/job-copilot.png",
      "32": "icons/job-copilot.png",
      "48": "icons/job-copilot.png",
      "128": "icons/job-copilot.png"
    },
    "default_title": "Job Copilot",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Autofill current page"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end",
      "css": [
        "content-scripts/content.css"
      ],
      "js": [
        "content-scripts/content.js"
      ]
    }
  ]
}
